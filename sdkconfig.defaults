# Target + board memory (ESP32-S3R8, 16 MB flash)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BOARD_LCD_MIRROR_X=y

# The USB-C port is the ESP32-S3 native USB (no UART bridge on the schematic),
# so send the console there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM (octal, 8 MB) is not needed by this app, so it is left off.
# To use it:
#   CONFIG_SPIRAM=y
#   CONFIG_SPIRAM_MODE_OCT=y
#   CONFIG_SPIRAM_SPEED_80M=y
